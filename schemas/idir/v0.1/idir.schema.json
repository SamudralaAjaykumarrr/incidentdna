{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SamudralaAjaykumarrr/incidentdna/schemas/idir/v0.1/idir.schema.json",
  "title": "IncidentDNA IDIR v0.1",
  "description": "Incident Deterministic Intermediate Representation, schema version 0.1. This document is a structural, documentation-grade reference for the IDIR format: it mirrors the Go types in internal/idir/types.go. The authoritative enforcement mechanism is the hand-written semantic validator in internal/validate (see docs/idir-specification-v0.1.md, 'Why not pure JSON Schema validation'), because rules like acyclic causality, dangling-reference detection, and known-sensitive-location redaction checks cannot be expressed in JSON Schema alone.",
  "type": "object",
  "required": [
    "schema_version",
    "incident",
    "application",
    "trigger",
    "events",
    "services",
    "side_effects",
    "business_invariants",
    "expected_corrected_behavior",
    "evidence",
    "reproduction_sequence",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Must equal \"0.1\" for this schema version. Unsupported versions are rejected by validation.",
      "const": "0.1"
    },
    "incident": {
      "type": "object",
      "required": ["id", "title", "summary", "occurred_at"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "occurred_at": { "type": "string", "format": "date-time" },
        "detected_at": { "type": "string", "format": "date-time" },
        "resolved_at": { "type": "string", "format": "date-time" }
      }
    },
    "application": {
      "type": "object",
      "required": ["name", "service", "environment", "release_version"],
      "properties": {
        "name": { "type": "string" },
        "service": { "type": "string" },
        "environment": { "type": "string" },
        "release_version": { "type": "string" },
        "commit_ref": { "type": "string" }
      }
    },
    "trigger": {
      "type": "object",
      "required": ["type", "description"],
      "properties": {
        "type": { "type": "string" },
        "description": { "type": "string" },
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "raw_payload_excerpt": {
          "type": "string",
          "description": "Known sensitive location: must be empty when privacy.redacted is true."
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string" },
          "description": { "type": "string" },
          "caused_by": {
            "type": "array",
            "items": { "type": "string" },
            "description": "IDs of events that causally precede this one. Must reference defined event ids and must not form a cycle (enforced by internal/validate, not expressible here)."
          },
          "raw_payload_excerpt": {
            "type": "string",
            "description": "Known sensitive location: must be empty when privacy.redacted is true."
          }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role", "technology_category"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "technology_category": { "type": "string" }
        }
      }
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "description", "affected_entity", "reversible"],
        "properties": {
          "type": { "type": "string" },
          "description": { "type": "string" },
          "affected_entity": { "type": "string" },
          "reversible": { "type": "boolean" }
        }
      }
    },
    "business_invariants": {
      "type": "array",
      "minItems": 1,
      "description": "At least one violated business invariant is required.",
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "properties": {
          "id": { "type": "string" },
          "statement": { "type": "string", "minLength": 1 }
        }
      }
    },
    "expected_corrected_behavior": {
      "type": "array",
      "minItems": 1,
      "description": "Must contain at least one non-empty statement.",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "location", "digest"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "location": {
            "type": "string",
            "description": "Inert metadata. Never dereferenced or opened by the incidentdna CLI, and excluded from the fingerprint."
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Must be a sha256:-prefixed 64-character lowercase hex digest."
          },
          "raw_excerpt": {
            "type": "string",
            "description": "Known sensitive location: must be empty when privacy.redacted is true."
          }
        }
      }
    },
    "reproduction_sequence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "description"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" },
          "ref_event_id": {
            "type": "string",
            "description": "If set, must reference a defined events[].id (enforced by internal/validate)."
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "required": ["sensitivity", "redacted"],
      "properties": {
        "sensitivity": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "redacted": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
